// Esquema de base de datos de TripSync
// Define todas las tablas: usuarios, viajes, gastos, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth) ─────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─── Usuario ─────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  image           String?
  password        String?
  emailVerified   DateTime?
  defaultCurrency String    @default("USD")
  createdAt       DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  memberships    TripMember[]
  expensesPaid   Expense[]      @relation("ExpensePayer")
  shares         ExpenseShare[]
  messages       ChatMessage[]
  documents      Document[]
  checklistItems ChecklistItem[]
}

// ─── Viaje ───────────────────────────────────────────

model Trip {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  emoji        String   @default("✈️")
  startDate    DateTime
  endDate      DateTime
  budget       Float?
  baseCurrency String   @default("USD")
  createdAt    DateTime @default(now())

  members        TripMember[]
  expenses       Expense[]
  itineraryDays  ItineraryDay[]
  checklistItems ChecklistItem[]
  documents      Document[]
  messages       ChatMessage[]
}

enum Role {
  ADMIN
  MEMBER
}

model TripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tripId, userId])
}

// ─── Gastos ──────────────────────────────────────────

model Expense {
  id         String   @id @default(cuid())
  tripId     String
  payerId    String
  title      String
  amount     Float
  currency   String   @default("USD")
  category   String   @default("other")
  occurredAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer  User           @relation("ExpensePayer", fields: [payerId], references: [id])
  shares ExpenseShare[]
}

model ExpenseShare {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  amount    Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  @@unique([expenseId, userId])
}

// ─── Itinerario ──────────────────────────────────────

model ItineraryDay {
  id     String   @id @default(cuid())
  tripId String
  date   DateTime
  title  String?

  trip   Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  events ItineraryEvent[]
  @@unique([tripId, date])
}

model ItineraryEvent {
  id          String   @id @default(cuid())
  dayId       String
  time        String
  title       String
  description String?
  category    String   @default("activity")
  location    String?
  mapsLink    String?
  createdAt   DateTime @default(now())

  day ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

// ─── Checklist ───────────────────────────────────────

model ChecklistItem {
  id         String   @id @default(cuid())
  tripId     String
  text       String
  done       Boolean  @default(false)
  assigneeId String?
  createdAt  DateTime @default(now())

  trip     Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id])
}

// ─── Documentos ──────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  tripId     String
  uploaderId String
  title      String
  type       String   @default("other")
  fileUrl    String
  fileKey    String
  fileSize   Int      @default(0)
  createdAt  DateTime @default(now())

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])
}

// ─── Chat ────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  tripId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}
